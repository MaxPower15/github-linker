{
    "name": "github-linker",
    "displayName": "GitHub linker (allow default branch)",
    "description": "Create links to fragments of code in GitHub",
    "version": "0.0.1",
    "publisher": "MaxPower15",
    "engines": {
        "vscode": "^1.80.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/MaxPower15/github-linker.git"
    },
    "categories": [
        "Other"
    ],
    "main": "./out/extension",
    "icon": "icon.png",
    "contributes": {
        "commands": [
            {
                "when": "editorTextFocus || editorHasSelection",
                "command": "githublinker.copyLink",
                "title": "GitHub linker: Copy link to selection"
            },
            {
                "when": "editorTextFocus || editorHasSelection",
                "command": "githublinker.copyMarkdown",
                "title": "GitHub linker: Copy link to selection and code as markdown"
            },
            {
                "when": "editorTextFocus || editorHasSelection",
                "command": "githublinker.copyDefaultBranchLink",
                "title": "GitHub linker: Copy link to selection (using default branch)"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "when": "editorTextFocus || editorHasSelection",
                    "command": "githublinker.copyLink",
                    "group": "9_cutcopypaste"
                },
                {
                    "when": "editorTextFocus || editorHasSelection",
                    "command": "githublinker.copyMarkdown",
                    "group": "9_cutcopypaste"
                },
                {
                    "when": "editorTextFocus || editorHasSelection",
                    "command": "githublinker.copyDefaultBranchLink",
                    "group": "9_cutcopypaste"
                }
            ]
        },
        "configuration": {
            "title": "GitHub Linker",
            "properties": {
                "githublinker.defaultBranch": {
                    "type": "string",
                    "default": "main",
                    "description": "Default branch to use when current branch is not found on GitHub"
                }
            }
        }
    },
    "devDependencies": {
        "@types/glob": "^8.1.0",
        "@types/mocha": "^2.2.42",
        "@types/node": "^16.11.26",
        "@types/vscode": "^1.80.0",
        "@vscode/test-electron": "^2.1.3",
        "glob": "^7.2.0",
        "mocha": "^9.2.2",
        "tslint": "^5.8.0",
        "typescript": "^5.0.0"
    },
    "dependencies": {
        "@types/clipboardy": "^1.1.0",
        "@types/ini": "^1.3.30",
        "clipboardy": "^2.3.0",
        "ini": "^2.0.0"
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile",
        "test": "node ./out/test/runTest.js"
    }
}
